# Local development (copy to apps/web/.env.local). Values match docker-compose.yml.
# Never put staging or production secrets in a file (R11); they live in Secret Manager.
APP_ENV=local
APP_BASE_URL=http://localhost:3000

# Runtime role (non-owner, subject to RLS) and the owner role used by migrations.
DATABASE_URL=postgres://verilo_runtime:verilo_runtime@localhost:5432/verilo
MIGRATE_DATABASE_URL=postgres://verilo_owner:verilo@localhost:5432/verilo

# Auth.js secret (any 32+ random characters locally: `openssl rand -base64 32`)
AUTH_SECRET=change-me-local-only-change-me-local-only
# 32 random bytes, base64 (`openssl rand -base64 32`). Staging/production use KMS_KEY_NAME instead.
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Storage: MinIO via the S3 API
STORAGE_DRIVER=s3
FILES_BUCKET=verilo-files
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=verilo
S3_SECRET_ACCESS_KEY=verilo-secret

# Virus scan: the ClamAV HTTP wrapper
CLAMAV_URL=http://localhost:8090

# Email: Mailpit (UI at http://localhost:8025)
MAILPIT_URL=http://localhost:8025
EMAIL_FROM=Verilo <no-reply@verilo.local>
INBOUND_EMAIL_DOMAIN=inbound.localhost

LOG_LEVEL=info

# AI extraction (8.1): "fixture" answers from packages/integrations/ai/fixtures by file hash;
# "gemini" needs VERTEX_MODEL, GCP_PROJECT, VERTEX_LOCATION and Google credentials.
EXTRACTOR=fixture

# Inbound email webhook password (section 9). Postmark posts to
# http://postmark:<this>@localhost:3000/api/inbound-email/postmark
POSTMARK_INBOUND_WEBHOOK_SECRET=local-inbound-webhook-secret
